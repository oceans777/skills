#!/bin/sh
set -eu

REPO_ROOT=$(CDPATH= cd "$(dirname "$0")" && pwd)
COMMAND=${1:-help}
if [ "$#" -gt 0 ]; then shift; fi

case "$COMMAND" in
  sync) sh "$REPO_ROOT/scripts/sync.sh" ;;
  install) sh "$REPO_ROOT/scripts/install-skills.sh" "$@" ;;
  validate) sh "$REPO_ROOT/scripts/validate-skills.sh" "$@" ;;
  test) sh "$REPO_ROOT/scripts/test.sh" ;;
  status) sh "$REPO_ROOT/scripts/status.sh" "$@" ;;
  import) sh "$REPO_ROOT/scripts/import-skills.sh" "$@" ;;
  stage) sh "$REPO_ROOT/scripts/stage-skill.sh" "$@" ;;
  publish) sh "$REPO_ROOT/scripts/publish-skills.sh" "$@" ;;
  add) sh "$REPO_ROOT/scripts/add-skill-from-url.sh" "$@" ;;
  catalog) sh "$REPO_ROOT/scripts/catalog-skill.sh" "$@" ;;
  help)
    echo "oceans777 skills commands:"
    echo
    echo "Daily user commands:"
    echo "  ./oceans sync      Pull updates, update child repositories, and enforce lifecycle blocks"
    echo "  ./oceans install   Reconcile lifecycle state and install active skills"
    echo "  ./oceans validate  Validate repositories, catalog, and review candidates"
    echo "  ./oceans test      Run the platform test suite"
    echo "  ./oceans status    Show repository and runtime skill root status"
    echo "  ./oceans import    Scan local runtime skills and print an import review report"
    echo "  ./oceans catalog   List, approve, reject, or change lifecycle state"
    echo
    echo "Maintainer publishing commands:"
    echo "  ./oceans add       Queue one GitHub skill URL for isolated review"
    echo "  ./oceans stage     Stage one trusted local skill into an oceans777 repository"
    echo "  ./oceans publish   Publish child commits, catalog, and submodule pointers coherently"
    ;;
  *)
    echo "Unknown command: $COMMAND" >&2
    echo "Run './oceans help' for available commands." >&2
    exit 2
    ;;
esac
